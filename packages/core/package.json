{
  "name": "@repo/core",
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "dotenv -- nodemon dist/index.cjs",
    "build": "node ./esbuild.config.js",
    "build:watch": "WATCH_MODE=true npm run build",
    "check-types": "tsc",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\" --log-level warn",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:setup": "dotenv -- tsx src/storage/setup.ts"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "aws-sdk-client-mock": "^4.1.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1144.0",
    "@aws-sdk/client-scheduler": "^3.1145.0",
    "@aws-sdk/client-sqs": "^3.1145.0",
    "@aws-sdk/lib-dynamodb": "^3.1144.0",
    "@trpc/server": "^11.19.0",
    "zod": "^4.6.5"
  }
}
