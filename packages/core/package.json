{
  "name": "@repo/core",
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./infra": {
      "types": "./infra/index.ts",
      "default": "./infra/index.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "dotenv -- nodemon dist/index.cjs",
    "build": "node ./esbuild.config.js",
    "build:watch": "WATCH_MODE=true npm run build",
    "check-types": "tsc",
    "lint": "eslint 'src/**/*.ts' 'infra/**/*.ts' 'scripts/**/*.ts'",
    "format": "prettier --write \"{src,infra,scripts}/**/*.ts\" --log-level warn",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:cognito-local": "tsx scripts/setup-cognito-local.ts",
    "cdk:bootstrap:local": "cdklocal bootstrap --context stage=local",
    "cdk:deploy:local": "cdklocal deploy --context stage=local --require-approval never --outputs-file cdk-outputs.json",
    "cdk:synth": "cdk synth --context stage=aws",
    "cdk:deploy": "cdk deploy --context stage=aws --outputs-file cdk-outputs.json"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "aws-cdk-local": "^3.0.4",
    "aws-sdk-client-mock": "^4.1.0",
    "constructs": "^10.8.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1149.0",
    "@aws-sdk/client-dynamodb": "^3.1144.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-scheduler": "^3.1145.0",
    "@aws-sdk/client-sqs": "^3.1145.0",
    "@aws-sdk/lib-dynamodb": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@trpc/server": "^11.19.0",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  }
}
