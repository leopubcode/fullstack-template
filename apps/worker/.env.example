# Read by `npm run dev` through dotenv. Points at the docker compose Postgres,
# the same database the API adds jobs to.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Serves Sidequest's dashboard on this port. It has no auth, so leave it unset
# outside local development.
SIDEQUEST_DASHBOARD_PORT=8678

# Points the AWS SDK at the docker compose LocalStack.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack only routes presigned URLs signed for this host.
AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:4566
# core's config requires this even though no job handler uses it yet. Copy
# from packages/core/infra/files/cdk-outputs.json after
# `npm run cdk:deploy:local --workspace=@repo/core`.
FILES_BUCKET_NAME=
