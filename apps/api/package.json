{
  "name": "@repo/api",
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "dotenv -- nodemon dist/index.cjs",
    "build": "node ./esbuild.config.js",
    "build:watch": "WATCH_MODE=true npm run build",
    "check-types": "tsc",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\" --log-level warn"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.x.x",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@repo/core": "*",
    "@repo/utils": "*",
    "cors": "^2.8.6",
    "esbuild-plugin-noexternal": "^0.1.6",
    "express": "^5.3.0"
  }
}
