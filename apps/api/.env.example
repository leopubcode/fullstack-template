# Read by `npm run dev` through dotenv. Points the AWS SDK at LocalStack.
# The deployed Lambda gets its env from the CDK stack instead.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack only routes presigned URLs signed for this host.
AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:4566
# cognito-local (docker-compose), not LocalStack, serves the identity provider.
AWS_ENDPOINT_URL_COGNITO_IDENTITY_PROVIDER=http://localhost:9229
# Copy from packages/core/cdk-outputs.json after core's `npm run cdk:deploy:local`.
USERS_TABLE_NAME=
JOB_QUEUE_ARN=
JOB_QUEUE_URL=
JOB_SCHEDULE_GROUP_NAME=
JOB_SCHEDULER_ROLE_ARN=
FILES_BUCKET_NAME=
# Printed by packages/core/scripts/setup-cognito-local.sh.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER_URL=
