# Read by `npm run dev` through dotenv. Points at the docker compose Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Points the AWS SDK at the docker compose LocalStack.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack only routes presigned URLs signed for this host.
AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:4566
# Copy from packages/core/infra/files/cdk-outputs.json after
# `npm run cdk:deploy:local --workspace=@repo/core`.
FILES_BUCKET_NAME=

# Points at the docker compose Keycloak and the `app` realm it imports from
# packages/core/infra/keycloak. The secret is the realm file's dev-only one.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=app
KEYCLOAK_CLIENT_ID=api
KEYCLOAK_CLIENT_SECRET=local-api-secret
KEYCLOAK_VERIFY_EMAIL_REDIRECT_URI=http://localhost:5173/signin?verified=1
