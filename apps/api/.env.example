# Read by `npm run dev` through dotenv. Points the AWS SDK at LocalStack.
# The deployed Lambda gets its env from the CDK stack instead.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack only routes presigned URLs signed for this host.
AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:4566
# Copy from apps/worker/cdk-outputs.json after `npm run cdk:deploy:local`.
JOB_QUEUE_ARN=
JOB_QUEUE_URL=
JOB_SCHEDULE_GROUP_NAME=
JOB_SCHEDULER_ROLE_ARN=
FILES_BUCKET_NAME=

USERS_TABLE_NAME=Users
